.DS_Store

# Nothing at the top level is published unless it is listed here. The working
# folder also holds router configs, private keys, credentials and scratch
# captures, and none of those may reach a public repo.
/*
!/README.md
!/RELEASE_NOTES.md
!/THIRD-PARTY.md
!/LICENSE
!/.gitignore
!/.github/
!/ZLTApp/
!/awg/
!/build/
!/fetch-payload.sh

AndroidApp/.build/
*.idsig

# The 28 MB sing-box payload is fetched by fetch-payload.sh, never committed.
build/sing-box.gz
