#!/bin/sh
# vpn — control the AmneziaWG tunnel on the ZLT X28 (root mode)
#
#   vpn awg on       route the LAN through the tunnel (and keep it on after reboot)
#   vpn awg off      back to the raw carrier connection (and keep it off after reboot)
#   vpn awg restart  off + on
#   vpn awg status   daemon, handshake, route, and the IP the LAN actually exits from
#
# Design note: only traffic ORIGINATING on the LAN is redirected. The vendor's policy
# table 17000 already carries "default dev ccmni1" plus the LAN route, and the kernel
# rules send LAN traffic there — so replacing its default is the whole trick. The
# router's own traffic (modem daemons, AT channel, DNS upstream) keeps using the main
# table and is never disturbed.
#
# The daemon is owned by procd (/etc/init.d/amneziawg) whenever that service is
# available: procd survives telnet/SSH disconnects and restarts the daemon if it dies.
# Set AMNEZIAWG_FROM_INIT=1 to mean "we are being called BY the service — do not
# re-enter the service" (prevents recursion).

TUN=awg0
CONF=/etc/amneziawg/$TUN.conf
SOCK=/var/run/amneziawg/$TUN.sock
TABLE=17000
WAN=ccmni1
LAN_IP=192.168.70.1
DOT=127.0.0.2
RESOLV=/tmp/dnsmasq_resolv.conf
INIT=/etc/init.d/amneziawg

SB_BIN=/data/zltx28/bin/sing-box
SB_DIR=/data/zltx28/singbox
SB_TUN=sb0
SB_INIT=/etc/init.d/singbox
SB_PORT=18080

# rc.common holds /var/lock/procd_<name>.lock on fd 1000 and every child inherits
# it; a long-lived child (dotbridge, started from here) then keeps the flock held
# and every later init-script call blocks in procd_lock. Drop our copy.
exec 1000<&- 2>/dev/null

say() { echo "$@"; }
running() { pgrep -f "amneziawg-go $TUN" >/dev/null 2>&1; }
conf_addr() { awk -F' *= *' 'tolower($1)=="address" {print $2; exit}' "$1" | cut -d, -f1; }
active_conf() { active_name 2>/dev/null || echo custom; }
use_conf() {
    name=$1
    case "$name" in
        "") say "usage: vpn awg use <name>   (see 'vpn awg list')"; return 2 ;;
        *[!A-Za-z0-9_-]*) say "FAILED: config name may only contain letters, digits, - and _"; return 2 ;;
    esac
    [ "$name" = current ] && name=$(active_name)
    src=$CONF.$name
    [ -f "$src" ] || { say "FAILED: $src not found (see 'vpn awg list')"; return 1; }
    cp "$src" "$CONF" || { say "FAILED: could not install $src"; return 1; }
    say "config now: $(active_conf)  (run 'vpn awg restart' to apply)"
}
active_name() {
    for f in "$CONF".*; do
        [ -f "$f" ] || continue
        cmp -s "$CONF" "$f" && { basename "$f" | sed 's/^awg0\.conf\.//'; return; }
    done
    echo custom
}
list_conf() {
    for f in "$CONF".*; do
        [ -f "$f" ] || continue
        n=$(basename "$f" | sed 's/^awg0\.conf\.//')
        [ "$n" = current ] || echo "$n"
    done
}
# Ask the filesystem, not the init script: "${INIT} enabled" takes the procd lock.
boot_state() {
    if [ -x /etc/rc.d/S99amneziawg ]; then echo "enabled"; else echo "disabled"; fi
}

on() {
    # Only one engine may own table 17000 at a time.
    if sb_running; then "$0" sb off; fi

    # Let procd own the daemon when the service exists. Calling start on a service
    # that is already running hangs under procd, so only start it when it is down.
    if [ -z "$AMNEZIAWG_FROM_INIT" ] && [ -x "$INIT" ]; then
        "$INIT" enable >/dev/null 2>&1
        if ! running; then
            AMNEZIAWG_FROM_INIT=1 "$INIT" start >/dev/null 2>&1
            i=0
            while [ $i -lt 25 ] && ! running; do i=$((i + 1)); sleep 1; done
        fi
    fi

    if ! running; then
        # A killed daemon can leave the tun device behind, and a new instance then dies
        # with "device or resource busy" — clear it first.
        if ip link show "$TUN" >/dev/null 2>&1; then
            ip link delete "$TUN" 2>/dev/null
            sleep 1
        fi
        # Do NOT set WG_PROCESS_FOREGROUND here: that makes the daemon run in the
        # foreground and this script would hang on the next line forever. Without it
        # the daemon detaches itself, which is what an ad-hoc start wants.
        /usr/bin/amneziawg-go "$TUN" >/dev/null 2>&1
    fi

    i=0
    while [ $i -lt 20 ]; do
        [ -S "$SOCK" ] && break
        i=$((i + 1)); sleep 1
    done
    [ -S "$SOCK" ] || { say "FAILED: daemon socket never appeared"; return 1; }
    ip link show "$TUN" >/dev/null 2>&1 || { say "FAILED: interface $TUN did not come up"; return 1; }

    ip addr add "$(conf_addr "$CONF")" dev "$TUN" 2>/dev/null
    ip link set "$TUN" mtu 1280 up

    # The router's awgctl predates header_protection_key and silently drops it,
    # which leaves an AWG 3.x server cutting every handshake. uapipush speaks the
    # same UAPI but understands the newer fields.
    if grep -qi '^HeaderProtectionKey' "$CONF" && [ -x /usr/bin/uapipush ]; then
        /usr/bin/uapipush "$SOCK" "$CONF" | grep -q '^errno=0' || { say "FAILED: config push"; return 1; }
    else
        /usr/bin/awgctl push "$SOCK" "$CONF" || { say "FAILED: config push"; return 1; }
    fi

    # Fail-safe: never divert the LAN into a tunnel that has no handshake. WireGuard
    # retries the handshake every ~5s, so a short wait is normally enough. If it never
    # comes up we leave the LAN on the raw carrier rather than blackholing it.
    hs=0
    i=0
    while [ $i -lt 20 ]; do
        hs=$(/usr/bin/awgctl show "$SOCK" 2>/dev/null | sed -n 's/^last_handshake_time_sec=//p')
        [ -n "$hs" ] && [ "$hs" != "0" ] && break
        i=$((i + 1)); sleep 1
    done
    if [ -z "$hs" ] || [ "$hs" = "0" ]; then
        say "FAILED: no handshake after ${i}s — LAN left on the raw carrier"
        return 1
    fi

    # Stronger gate: prove the tunnel actually CARRIES packets before diverting the LAN.
    # A handshake alone is not proof (the server can answer handshakes and still drop
    # data), and diverting into a dead tunnel would take the whole house offline.
    if ! ping -c2 -W3 -I "$TUN" 8.8.8.8 >/dev/null 2>&1; then
        say "FAILED: tunnel established but carries no traffic — LAN left on the raw carrier"
        return 1
    fi

    ip route replace default dev "$TUN" table $TABLE

    iptables -t nat -C POSTROUTING -o "$TUN" -j MASQUERADE 2>/dev/null || \
        iptables -t nat -A POSTROUTING -o "$TUN" -j MASQUERADE
    iptables -t mangle -C FORWARD -o "$TUN" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || \
        iptables -t mangle -A FORWARD -o "$TUN" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu

    # DNS: the carrier resolvers answer with censorship sinkholes (10.10.34.x) and
    # the tunnel's own resolver drops some names outright. dotbridge forwards to
    # 1.1.1.1 over TLS on 853, which the tunnel carries unchanged.
    ip route replace 1.1.1.1/32 dev "$TUN"
    ip route replace 100.64.0.1/32 dev "$TUN"
    if ! pgrep -x dotbridge >/dev/null 2>&1; then
        /usr/bin/dotbridge -listen $DOT:53 >/tmp/dotbridge.log 2>&1 &
        sleep 1
    fi
    [ -f "$RESOLV.carrier" ] || cp "$RESOLV" "$RESOLV.carrier" 2>/dev/null
    echo "nameserver $DOT" > "$RESOLV"
    kill -HUP $(pgrep -x dnsmasq) 2>/dev/null

    say "amneziawg ON  (LAN -> tunnel via table $TABLE, back at boot: $(boot_state))"
}

off() {
    # Stop the procd service first, otherwise it would respawn the daemon we kill below.
    if [ -z "$AMNEZIAWG_FROM_INIT" ] && [ -x "$INIT" ]; then
        AMNEZIAWG_FROM_INIT=1 "$INIT" stop >/dev/null 2>&1
        "$INIT" disable >/dev/null 2>&1
    fi

    ip route replace default dev "$WAN" table $TABLE 2>/dev/null
    ip route del 1.1.1.1/32 dev "$TUN" 2>/dev/null
    ip route del 100.64.0.1/32 dev "$TUN" 2>/dev/null
    if [ -f "$RESOLV.carrier" ]; then
        cp "$RESOLV.carrier" "$RESOLV"
        kill -HUP $(pgrep -x dnsmasq) 2>/dev/null
    fi
    iptables -t nat -D POSTROUTING -o "$TUN" -j MASQUERADE 2>/dev/null
    iptables -t mangle -D FORWARD -o "$TUN" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null
    if running; then
        kill $(pgrep -f "amneziawg-go $TUN") 2>/dev/null
    fi
    i=0
    while [ $i -lt 10 ]; do
        ip link show "$TUN" >/dev/null 2>&1 || break
        i=$((i + 1)); sleep 1
    done
    ip link delete "$TUN" 2>/dev/null
    say "amneziawg OFF (LAN -> raw carrier, back at boot: $(boot_state))"
}

status() {
    if running; then say "daemon   : running"; else say "daemon   : stopped"; fi
    say "config   : $(active_conf)"
    say "boot     : $(boot_state)  (comes back after a reboot only if enabled)"
    ip route show table $TABLE 2>/dev/null | sed 's/^/route    : /'
    if [ -S "$SOCK" ]; then
        /usr/bin/awgctl show "$SOCK" 2>/dev/null | \
            grep -E 'last_handshake|tx_bytes|rx_bytes|endpoint=' | sed 's/^/tunnel   : /'
    fi
    say -n "exit IP  : "
    curl -s --interface $LAN_IP --max-time 10 https://api.ipify.org 2>/dev/null || say -n "(no answer)"
    say ""
}

# ---------------------------------------------------------------- sing-box
# A second engine, for share links (vless://, vmess://, trojan://, ss://,
# hysteria2://). Same policy as AmneziaWG above: only LAN traffic is diverted,
# through its own tun device and the same table 17000.

sb_running() { pgrep -f "sing-box run -c $SB_DIR/active.json" >/dev/null 2>&1; }
sb_boot() {
    if [ -x /etc/rc.d/S99singbox ]; then echo "enabled"; else echo "disabled"; fi
}
sb_active() {
    if [ -f "$SB_DIR/active_name" ]; then cat "$SB_DIR/active_name"; else echo "-"; fi
}
sb_links() {
    for f in "$SB_DIR"/links/*.json; do
        [ -f "$f" ] || continue
        n=${f##*/}
        case "$n" in *.test.json) continue ;; esac
        echo "${n%.json}"
    done
}

sb_route() {
    i=0
    while [ $i -lt 25 ]; do
        ip link show "$SB_TUN" >/dev/null 2>&1 && break
        i=$((i + 1)); sleep 1
    done
    if ! ip link show "$SB_TUN" >/dev/null 2>&1; then
        say "FAILED: $SB_TUN did not come up — LAN left on the raw carrier"
        return 1
    fi

    # Gate: prove the proxy actually carries traffic before diverting the LAN.
    # 1.1.1.1 is used by address, so a censored local resolver cannot veto the test.
    ok=0
    j=0
    while [ $j -lt 4 ]; do
        code=$(curl -s -o /dev/null --interface "$SB_TUN" --max-time 10 \
            -w '%{http_code}' https://1.1.1.1 2>/dev/null)
        [ -n "$code" ] && [ "$code" != "000" ] && { ok=1; break; }
        j=$((j + 1)); sleep 1
    done
    if [ "$ok" != "1" ]; then
        say "FAILED: the link is up but carries no traffic — LAN left on the raw carrier"
        return 1
    fi

    ip route replace default dev "$SB_TUN" table $TABLE

    iptables -t nat -C POSTROUTING -o "$SB_TUN" -j MASQUERADE 2>/dev/null || \
        iptables -t nat -A POSTROUTING -o "$SB_TUN" -j MASQUERADE
    iptables -t mangle -C FORWARD -o "$SB_TUN" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || \
        iptables -t mangle -A FORWARD -o "$SB_TUN" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu

    ip route replace 1.1.1.1/32 dev "$SB_TUN"
    ip route replace 100.64.0.1/32 dev "$SB_TUN"
    if ! pgrep -x dotbridge >/dev/null 2>&1; then
        /usr/bin/dotbridge -listen $DOT:53 >/tmp/dotbridge.log 2>&1 &
        sleep 1
    fi
    [ -f "$RESOLV.carrier" ] || cp "$RESOLV" "$RESOLV.carrier" 2>/dev/null
    echo "nameserver $DOT" > "$RESOLV"
    kill -HUP $(pgrep -x dnsmasq) 2>/dev/null
    say "singbox ON  (link: $(sb_active), LAN -> tunnel via table $TABLE, back at boot: $(sb_boot))"
}

sb_unroute() {
    if ! running; then
        ip route replace default dev "$WAN" table $TABLE 2>/dev/null
    fi
    ip route del 1.1.1.1/32 dev "$SB_TUN" 2>/dev/null
    ip route del 100.64.0.1/32 dev "$SB_TUN" 2>/dev/null
    if [ -f "$RESOLV.carrier" ]; then
        cp "$RESOLV.carrier" "$RESOLV"
        kill -HUP $(pgrep -x dnsmasq) 2>/dev/null
    fi
    iptables -t nat -D POSTROUTING -o "$SB_TUN" -j MASQUERADE 2>/dev/null
    iptables -t mangle -D FORWARD -o "$SB_TUN" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null
}

sb_stop() {
    if [ -z "$SB_FROM_INIT" ] && [ -x "$SB_INIT" ]; then
        SB_FROM_INIT=1 "$SB_INIT" stop >/dev/null 2>&1
        "$SB_INIT" disable >/dev/null 2>&1
    fi
    pids=$(pgrep -f "sing-box run -c $SB_DIR/active.json" 2>/dev/null)
    [ -n "$pids" ] && kill $pids 2>/dev/null
    # A new daemon that attaches to a tun the old one still holds gets no
    # packets at all — the device exists but nobody drains it. So wait for the
    # process itself to be gone, not just for the link to disappear.
    i=0
    while [ $i -lt 10 ]; do
        pgrep -f "sing-box run -c $SB_DIR/active.json" >/dev/null 2>&1 || break
        i=$((i + 1)); sleep 1
    done
    if pgrep -f "sing-box run -c $SB_DIR/active.json" >/dev/null 2>&1; then
        kill -9 $(pgrep -f "sing-box run -c $SB_DIR/active.json") 2>/dev/null
        sleep 1
    fi
    i=0
    while [ $i -lt 10 ]; do
        ip link show "$SB_TUN" >/dev/null 2>&1 || break
        i=$((i + 1)); sleep 1
    done
    ip link delete "$SB_TUN" 2>/dev/null
}

sb_spawn() {
    if [ -z "$SB_FROM_INIT" ] && [ -x "$SB_INIT" ]; then
        "$SB_INIT" enable >/dev/null 2>&1
        if ! sb_running; then
            SB_FROM_INIT=1 "$SB_INIT" start >/dev/null 2>&1
        fi
    elif ! sb_running; then
        "$SB_BIN" run -c "$SB_DIR/active.json" >/tmp/singbox.log 2>&1 &
    fi
    i=0
    while [ $i -lt 20 ]; do
        sb_running && break
        i=$((i + 1)); sleep 1
    done
}

sb_on() {
    [ -x "$SB_BIN" ] || { say "FAILED: the link engine is not installed on this router"; return 1; }
    [ -f "$SB_DIR/active.json" ] || { say "FAILED: no link selected (add one in the app)"; return 1; }

    if running; then "$0" awg off; fi

    sb_spawn
    sb_route && return 0

    # The gate is strict, so a daemon that came up against a stale device would
    # otherwise strand the user. One clean restart, then the same gate again.
    say "no traffic yet — restarting the engine cleanly and retrying once…"
    sb_stop
    sb_spawn
    sb_route
}

sb_off() {
    sb_unroute
    sb_stop
    say "singbox OFF (LAN -> raw carrier, back at boot: $(sb_boot))"
}

sb_use() {
    name=$1
    case "$name" in
        "") say "usage: vpn sb use <name>   (see 'vpn sb list')"; return 2 ;;
        *[!A-Za-z0-9_-]*) say "FAILED: link name may only contain letters, digits, - and _"; return 2 ;;
    esac
    src=$SB_DIR/links/$name.json
    [ -f "$src" ] || { say "FAILED: $src not found (see 'vpn sb list')"; return 1; }
    cp "$src" "$SB_DIR/active.json" || { say "FAILED: could not install $src"; return 1; }
    echo "$name" > "$SB_DIR/active_name"
    say "link now: $name  (run 'vpn sb restart' to apply)"
}

sb_remove() {
    name=$1
    [ -n "$name" ] || { say "usage: vpn sb remove <name>"; return 2; }
    [ -f "$SB_DIR/links/$name.json" ] || { say "FAILED: no link named $name"; return 1; }
    d=$SB_DIR/trash/$name-$(date +%s)
    mkdir -p "$d"
    mv "$SB_DIR/links/$name.json" "$d/" 2>/dev/null
    mv "$SB_DIR/links/$name.test.json" "$d/" 2>/dev/null
    mv "$SB_DIR/links/$name.link" "$d/" 2>/dev/null
    if [ "$(sb_active)" = "$name" ]; then
        sb_off >/dev/null 2>&1
        rm -f "$SB_DIR/active.json"
        echo "-" > "$SB_DIR/active_name"
    fi
    say "removed $name (kept in $d)"
}

# Measure one link on a throwaway socks/http port, without touching the LAN route.
sb_test() {
    name=$1
    f=$SB_DIR/links/$name.test.json
    [ -f "$f" ] || { say "RESULT|$name|404|0|0"; return 1; }
    old=$(pgrep -f "sing-box run -c $f" 2>/dev/null)
    [ -n "$old" ] && kill $old 2>/dev/null
    "$SB_BIN" run -c "$f" >/tmp/sb-test-$name.log 2>&1 &
    tpid=$!

    code=000; ms=0; bps=0
    for try in 1 2 3 4; do
        sleep 1
        out=$(curl -s -o /dev/null --max-time 8 -x "http://127.0.0.1:$SB_PORT" \
            -w '%{http_code} %{time_total}' http://www.gstatic.com/generate_204 2>/dev/null)
        code=${out%% *}
        t=${out##* }
        case "$code" in
            204|200)
                ms=$(awk "BEGIN{printf \"%d\", $t*1000}")
                break ;;
        esac
    done
    if [ "$ms" -gt 0 ]; then
        bps=$(curl -s -o /dev/null --max-time 12 -x "http://127.0.0.1:$SB_PORT" \
            -w '%{speed_download}' 'http://speed.cloudflare.com/__down?bytes=2000000' 2>/dev/null)
    fi
    kill $tpid 2>/dev/null
    say "RESULT|$name|$code|$ms|${bps:-0}"
}

sb_testall() {
    for n in $(sb_links); do sb_test "$n"; done
}

sb_status() {
    if sb_running; then say "daemon   : running"; else say "daemon   : stopped"; fi
    say "link     : $(sb_active)"
    say "boot     : $(sb_boot)  (comes back after a reboot only if enabled)"
    ip route show table $TABLE 2>/dev/null | sed 's/^/route    : /'
    # The app polls this every few seconds, so the exit-IP lookup is opt-out:
    # 'vpn sb status quick' skips the outbound request entirely.
    if [ "$3" = "quick" ] || ! sb_running; then
        say "exit IP  : -"
    else
        say -n "exit IP  : "
        curl -s --interface $LAN_IP --max-time 5 https://api.ipify.org 2>/dev/null || say -n "(no answer)"
        say ""
    fi
}

sb_usage() {
    say "usage: vpn sb on|off|restart|status|list|use <name>|test <name>|testall|remove <name>"
    exit 2
}

usage() {
    say "usage: vpn awg on|off|restart|status|list|use <name>"
    say "  use     switch to a stored config /etc/amneziawg/awg0.conf.<name>"
    say "  list    stored config names"
    say "  on      send the whole LAN through the AmneziaWG tunnel (and enable at boot)"
    say "  off     send the whole LAN straight out the mobile carrier (and disable at boot)"
    say "  restart off then on"
    say "  status  show what is running and which IP the LAN exits from"
    exit 2
}

case "$1" in
    awg|"")
        case "$2" in
            on) on ;;
            off) off ;;
            restart) off; on ;;
            status) status ;;
            use) use_conf "$3" ;;
            list) list_conf ;;
            *) usage ;;
        esac
        ;;
    sb)
        case "$2" in
            on) sb_on ;;
            off) sb_off ;;
            restart) sb_off; sb_on ;;
            status) sb_status ;;
            route) sb_route ;;
            use) sb_use "$3" ;;
            list) sb_links ;;
            test) sb_test "$3" ;;
            testall) sb_testall ;;
            remove) sb_remove "$3" ;;
            *) sb_usage ;;
        esac
        ;;
    *) usage ;;
esac
