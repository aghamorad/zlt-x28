#!/bin/sh /etc/rc.common
# Local ZLT X28 dashboard. The server enforces the permitted LAN subnet.
USE_PROCD=1
START=98
STOP=11

start_service() {
    [ -x /data/zltx28/bin/zlt-web ] || return 0
    [ -s /data/zltx28/web/password ] || return 0
    procd_open_instance
    procd_set_param command /data/zltx28/bin/zlt-web \
        -addr 0.0.0.0:8080 \
        -auth-file /data/zltx28/web/password \
        -lan-cidr 192.168.70.0/24
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core="0"
    procd_close_instance
}
