#!/bin/sh /etc/rc.common
# sing-box on the ZLT X28. The process is supervised here; routing (table
# 17000, firewall) is applied by /usr/bin/vpn sb route, which waits for the
# tun device itself.

USE_PROCD=1
START=99
STOP=10

start_service() {
    [ -x /data/zltx28/bin/sing-box ] || return 0
    [ -f /data/zltx28/singbox/active.json ] || return 0

    procd_open_instance
    procd_set_param command /data/zltx28/bin/sing-box run -c /data/zltx28/singbox/active.json
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core="0"
    procd_close_instance

    SB_FROM_INIT=1 /usr/bin/vpn sb route >/dev/null 2>&1 &
}

stop_service() {
    SB_FROM_INIT=1 /usr/bin/vpn sb unroute >/dev/null 2>&1
}
